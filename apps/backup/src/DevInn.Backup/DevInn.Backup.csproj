<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DevInn.Backup.Tests" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="bin\**\*" />
        <Compile Remove="obj\**\*" />
        <EmbeddedResource Remove="bin\**\*" />
        <EmbeddedResource Remove="obj\**\*" />
        <None Remove="bin\**\*" />
        <None Remove="obj\**\*" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Program.cs" />
        <Compile Include="Configuration\**\*.cs" />
        <Compile Include="Files\**\*.cs" />
        <Compile Include="Jobs\**\*.cs" />
        <Compile Include="Manifests\**\*.cs" />
        <Compile Include="Observability\**\*.cs" />
        <Compile Include="Postgres\**\*.cs" />
        <Compile Include="Retention\**\*.cs" />
        <Compile Include="Storage\**\*.cs" />
        <Compile Include="System\**\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" Version="4.0.25.3" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
        <PackageReference Include="OpenTelemetry" Version="1.16.0" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    </ItemGroup>

</Project>
